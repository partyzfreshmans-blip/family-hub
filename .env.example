# Family Hub Environment Configuration
# Session Secret for JWT Authentication
JWT_SECRET=super_secret_family_hub_jwt_key_2026_change_in_production

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Database Configuration
# ==========================================
# 1. Turso Cloud Database (Recommended for Production & Vercel)
# TURSO_DATABASE_URL=libsql://your-db-name-org.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 2. Local SQLite fallback (used automatically if Turso is not configured)
DATABASE_PATH=./data/family_hub.db
